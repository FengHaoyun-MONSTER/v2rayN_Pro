<reactiveui:ReactiveUserControl
    x:Class="v2rayN.Views.SubscriptionInfoView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:reactiveui="http://reactiveui.net"
    xmlns:vms="clr-namespace:ServiceLib.ViewModels;assembly=ServiceLib"
    d:DesignHeight="720"
    d:DesignWidth="440"
    x:TypeArguments="vms:SubscriptionInfoViewModel"
    Style="{StaticResource ViewGlobal}"
    mc:Ignorable="d">
    <Border
        Padding="28,24"
        Background="{DynamicResource MaterialDesignPaper}"
        BorderBrush="{DynamicResource MaterialDesignDivider}"
        BorderThickness="0,0,1,0">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="24" />
                <RowDefinition Height="*" />
                <RowDefinition Height="24" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock
                        FontSize="13"
                        FontWeight="SemiBold"
                        Opacity="0.65"
                        Text="当前订阅" />
                    <TextBlock
                        x:Name="txtSubscriptionName"
                        Margin="0,6,0,0"
                        FontSize="24"
                        FontWeight="SemiBold"
                        TextTrimming="CharacterEllipsis" />
                    <TextBlock
                        x:Name="txtLastUpdated"
                        Margin="0,7,0,0"
                        FontSize="12"
                        Opacity="0.55" />
                </StackPanel>
                <Button
                    x:Name="btnHideSubscriptionDashboard"
                    Grid.Column="1"
                    Height="30"
                    Margin="12,0,0,0"
                    Padding="10,0"
                    VerticalAlignment="Top"
                    Content="隐藏首页"
                    Style="{StaticResource DefButton}"
                    ToolTip="隐藏首页" />
            </Grid>

            <Border
                Grid.Row="2"
                Padding="20"
                VerticalAlignment="Stretch"
                Background="{DynamicResource MaterialDesignPaper}"
                BorderBrush="{DynamicResource MaterialDesignDivider}"
                BorderThickness="1"
                CornerRadius="6">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="12" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon
                            Width="18"
                            Height="18"
                            Margin="0,0,8,0"
                            VerticalAlignment="Center"
                            Kind="BullhornOutline" />
                        <TextBlock
                            VerticalAlignment="Center"
                            FontSize="14"
                            FontWeight="SemiBold"
                            Text="服务公告" />
                    </StackPanel>
                    <ScrollViewer
                        Grid.Row="2"
                        HorizontalScrollBarVisibility="Disabled"
                        VerticalScrollBarVisibility="Auto">
                        <TextBlock
                            x:Name="txtAnnouncement"
                            FontSize="15"
                            LineHeight="26"
                            TextWrapping="Wrap" />
                    </ScrollViewer>
                </Grid>
            </Border>

            <Border
                Grid.Row="4"
                Background="{DynamicResource MaterialDesignPaper}"
                BorderBrush="{DynamicResource MaterialDesignDivider}"
                BorderThickness="1"
                CornerRadius="6">
                <Grid Height="92">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="1" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="1" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock HorizontalAlignment="Center" FontSize="12" Opacity="0.65" Text="剩余流量" />
                        <TextBlock
                            x:Name="txtRemainingTraffic"
                            Margin="4,7,4,0"
                            HorizontalAlignment="Center"
                            FontSize="17"
                            FontWeight="SemiBold"
                            TextAlignment="Center"
                            TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <Border Grid.Column="1" Height="38" Background="{DynamicResource MaterialDesignDivider}" />
                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                        <TextBlock HorizontalAlignment="Center" FontSize="12" Opacity="0.65" Text="剩余天数" />
                        <TextBlock
                            x:Name="txtRemainingDays"
                            Margin="4,7,4,0"
                            HorizontalAlignment="Center"
                            FontSize="17"
                            FontWeight="SemiBold"
                            TextAlignment="Center" />
                    </StackPanel>
                    <Border Grid.Column="3" Height="38" Background="{DynamicResource MaterialDesignDivider}" />
                    <StackPanel Grid.Column="4" VerticalAlignment="Center">
                        <TextBlock HorizontalAlignment="Center" FontSize="12" Opacity="0.65" Text="到期时间" />
                        <TextBlock
                            x:Name="txtExpireDate"
                            Margin="4,7,4,0"
                            HorizontalAlignment="Center"
                            FontSize="15"
                            FontWeight="SemiBold"
                            TextAlignment="Center"
                            TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</reactiveui:ReactiveUserControl>
