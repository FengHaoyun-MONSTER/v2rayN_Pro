<reactiveui:ReactiveUserControl
    x:Class="v2rayN.Views.SubscriptionInfoView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:reactiveui="http://reactiveui.net"
    xmlns:vms="clr-namespace:ServiceLib.ViewModels;assembly=ServiceLib"
    d:DesignHeight="720"
    d:DesignWidth="1180"
    x:TypeArguments="vms:SubscriptionInfoViewModel"
    Background="Transparent"
    Style="{StaticResource ViewGlobal}"
    mc:Ignorable="d">
    <ScrollViewer
        HorizontalScrollBarVisibility="Disabled"
        VerticalScrollBarVisibility="Auto">
        <Grid
            MaxWidth="1180"
            Margin="20"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Top">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="16" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" MinHeight="104">
                <Border
                    Background="{DynamicResource MaterialDesignPaper}"
                    BorderBrush="{DynamicResource MaterialDesignDivider}"
                    BorderThickness="1"
                    CornerRadius="6"
                    Opacity="0.9" />
                <Grid Margin="24,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="1" />
                        <ColumnDefinition Width="Auto" MinWidth="230" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <WrapPanel VerticalAlignment="Center">
                            <TextBlock
                                VerticalAlignment="Center"
                                FontSize="13"
                                FontWeight="SemiBold"
                                Opacity="0.65"
                                Text="当前订阅" />
                            <Border
                                Width="1"
                                Height="14"
                                Margin="12,0"
                                VerticalAlignment="Center"
                                Background="{DynamicResource MaterialDesignDivider}" />
                            <TextBlock VerticalAlignment="Center" FontSize="11" Opacity="0.62" Text="共有流量" />
                            <TextBlock
                                x:Name="txtTotalTraffic"
                                Margin="6,0,14,0"
                                VerticalAlignment="Center"
                                FontSize="13"
                                FontWeight="SemiBold" />
                            <TextBlock VerticalAlignment="Center" FontSize="11" Opacity="0.62" Text="剩余流量" />
                            <TextBlock
                                x:Name="txtRemainingTraffic"
                                Margin="6,0,14,0"
                                VerticalAlignment="Center"
                                FontSize="13"
                                FontWeight="SemiBold" />
                            <TextBlock VerticalAlignment="Center" FontSize="11" Opacity="0.62" Text="已用流量" />
                            <TextBlock
                                x:Name="txtUsedTraffic"
                                Margin="6,0,0,0"
                                VerticalAlignment="Center"
                                FontSize="13"
                                FontWeight="SemiBold" />
                        </WrapPanel>
                        <TextBlock
                            x:Name="txtSubscriptionName"
                            Margin="0,7,18,0"
                            FontSize="24"
                            FontWeight="SemiBold"
                            TextTrimming="CharacterEllipsis" />
                    </StackPanel>

                    <Border
                        Grid.Column="1"
                        Margin="8,4"
                        Background="{DynamicResource MaterialDesignDivider}" />

                    <StackPanel
                        Grid.Column="2"
                        Margin="22,0,0,0"
                        VerticalAlignment="Center">
                        <TextBlock
                            x:Name="txtLastUpdated"
                            HorizontalAlignment="Right"
                            FontSize="12"
                            Opacity="0.62" />
                        <StackPanel
                            Margin="0,10,0,0"
                            HorizontalAlignment="Right"
                            Orientation="Horizontal">
                            <TextBlock
                                Margin="0,0,8,0"
                                FontSize="13"
                                Opacity="0.65"
                                Text="到期" />
                            <TextBlock
                                x:Name="txtExpireDate"
                                FontSize="15"
                                FontWeight="SemiBold" />
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Grid>

            <Grid
                Grid.Row="2"
                MinHeight="132"
                MaxHeight="240">
                <Border
                    Background="{DynamicResource MaterialDesignPaper}"
                    BorderBrush="{DynamicResource MaterialDesignDivider}"
                    BorderThickness="1"
                    CornerRadius="6"
                    Opacity="0.88" />
                <Grid Margin="22,16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="12" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <DockPanel LastChildFill="True">
                        <Button
                            x:Name="btnSupport"
                            Height="32"
                            MinWidth="116"
                            Padding="12,0"
                            HorizontalAlignment="Right"
                            AutomationProperties.Name="点我有惊喜"
                            DockPanel.Dock="Right"
                            Style="{StaticResource DefButton}"
                            ToolTip="打开服务商提供的链接">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon
                                    Width="16"
                                    Height="16"
                                    Margin="0,0,6,0"
                                    VerticalAlignment="Center"
                                    Kind="GiftOutline" />
                                <TextBlock VerticalAlignment="Center" Text="点我有惊喜" />
                            </StackPanel>
                        </Button>
                        <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                            <materialDesign:PackIcon
                                Width="18"
                                Height="18"
                                Margin="0,0,8,0"
                                VerticalAlignment="Center"
                                Kind="BullhornOutline" />
                            <TextBlock
                                VerticalAlignment="Center"
                                FontSize="14"
                                FontWeight="SemiBold"
                                Text="服务公告" />
                        </StackPanel>
                    </DockPanel>

                    <ScrollViewer
                        Grid.Row="2"
                        HorizontalScrollBarVisibility="Disabled"
                        VerticalScrollBarVisibility="Auto">
                        <TextBlock
                            x:Name="txtAnnouncement"
                            FontSize="14"
                            LineHeight="24"
                            TextWrapping="Wrap" />
                    </ScrollViewer>
                </Grid>
            </Grid>

        </Grid>
    </ScrollViewer>
</reactiveui:ReactiveUserControl>
