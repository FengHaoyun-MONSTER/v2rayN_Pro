<UserControl
    x:Class="v2rayN.Desktop.Views.SubscriptionInfoView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vms="clr-namespace:ServiceLib.ViewModels;assembly=ServiceLib"
    d:DesignHeight="720"
    d:DesignWidth="1180"
    x:DataType="vms:SubscriptionInfoViewModel"
    Background="Transparent"
    mc:Ignorable="d">
    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <Grid
            MaxWidth="1180"
            Margin="20"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Top"
            RowDefinitions="Auto,16,Auto">
            <Border
                Grid.Row="0"
                MinHeight="104"
                Padding="24,16"
                Background="{DynamicResource SemiColorBg1}"
                BorderBrush="{DynamicResource SemiColorBorder}"
                BorderThickness="1"
                CornerRadius="6"
                Opacity="0.9">
                <Grid ColumnDefinitions="*,1,Auto">
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <WrapPanel VerticalAlignment="Center">
                            <TextBlock
                                VerticalAlignment="Center"
                                FontSize="13"
                                FontWeight="SemiBold"
                                Opacity="0.65"
                                Text="当前订阅" />
                            <Border
                                Width="1"
                                Height="14"
                                Margin="12,0"
                                VerticalAlignment="Center"
                                Background="{DynamicResource SemiColorBorder}" />
                            <TextBlock VerticalAlignment="Center" FontSize="11" Opacity="0.62" Text="共有流量" />
                            <TextBlock x:Name="txtTotalTraffic" Margin="6,0,14,0" FontSize="13" FontWeight="SemiBold" />
                            <TextBlock VerticalAlignment="Center" FontSize="11" Opacity="0.62" Text="剩余流量" />
                            <TextBlock x:Name="txtRemainingTraffic" Margin="6,0,14,0" FontSize="13" FontWeight="SemiBold" />
                            <TextBlock VerticalAlignment="Center" FontSize="11" Opacity="0.62" Text="已用流量" />
                            <TextBlock x:Name="txtUsedTraffic" Margin="6,0,0,0" FontSize="13" FontWeight="SemiBold" />
                        </WrapPanel>
                        <TextBlock
                            x:Name="txtSubscriptionName"
                            Margin="0,7,18,0"
                            FontSize="24"
                            FontWeight="SemiBold"
                            TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <Border Grid.Column="1" Margin="8,4" Background="{DynamicResource SemiColorBorder}" />
                    <StackPanel Grid.Column="2" MinWidth="230" Margin="22,0,0,0" VerticalAlignment="Center">
                        <TextBlock x:Name="txtLastUpdated" HorizontalAlignment="Right" FontSize="12" Opacity="0.62" />
                        <StackPanel Margin="0,10,0,0" HorizontalAlignment="Right" Orientation="Horizontal">
                            <TextBlock Margin="0,0,8,0" FontSize="13" Opacity="0.65" Text="到期" />
                            <TextBlock x:Name="txtExpireDate" FontSize="15" FontWeight="SemiBold" />
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>

            <Border
                Grid.Row="2"
                MinHeight="132"
                MaxHeight="240"
                Padding="22,16"
                Background="{DynamicResource SemiColorBg1}"
                BorderBrush="{DynamicResource SemiColorBorder}"
                BorderThickness="1"
                CornerRadius="6"
                Opacity="0.88">
                <Grid RowDefinitions="Auto,12,*">
                    <DockPanel LastChildFill="True">
                        <Button
                            x:Name="btnSupport"
                            Height="32"
                            MinWidth="116"
                            Padding="12,0"
                            HorizontalAlignment="Right"
                            Classes="Success"
                            Content="点我有惊喜"
                            DockPanel.Dock="Right"
                            ToolTip.Tip="打开服务商提供的链接" />
                        <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                            <TextBlock VerticalAlignment="Center" FontSize="14" FontWeight="SemiBold" Text="服务公告" />
                        </StackPanel>
                    </DockPanel>
                    <ScrollViewer Grid.Row="2" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                        <TextBlock x:Name="txtAnnouncement" FontSize="14" LineHeight="24" TextWrapping="Wrap" />
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>
